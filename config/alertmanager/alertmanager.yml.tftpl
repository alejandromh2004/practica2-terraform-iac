global:
  resolve_timeout: 1m

route:
  group_by: ['alertname']
  group_wait: 5s
  group_interval: 10s
  repeat_interval: 2m
  receiver: 'discord-alertas'

receivers:
  - name: 'discord-alertas'
    discord_configs:
      - webhook_url: '${discord_webhook_url}'
        send_resolved: true
        title: '{{ if eq .Status "firing" }}🚨 ALERTA POKÉDEX{{ else }}✅ ALERTA RESUELTA{{ end }} ({{ .CommonLabels.alertname }})'
        message: |-
          {{ range .Alerts -}}
          **Estado:** {{ .Status | toUpper }}
          **Severidad:** {{ .Labels.severity }}
          **Resumen:** {{ .Annotations.summary }}
          **Detalle:** {{ .Annotations.description }}
          {{ end }}
