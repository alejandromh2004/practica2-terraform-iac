      }
    },
    {
      "id": 104,
      "type": "row",
      "title": "5. Logs Centralizados (Loki \u2014 Aplicaciones y Bases de Datos)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "collapsed": false
    },
    {
      "id": 11,
      "title": "Registros en Vivo (Flask, Nginx, PostgreSQL, Redis y S3)",
      "type": "logs",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 33
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "{container_name=~\"(dev|pro)-(app|postgres|redis|load-balancer|s3-storage).*\"}",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    }
  ]
}